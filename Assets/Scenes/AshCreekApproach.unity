  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1542a6333b2994f5db5e1ed9b3e6ec51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ForgottenTrail.Runtime::ForgottenTrail.Gameplay.World.InteractableClue
  id: saloon.torn-note
  prompt: "Ler a anota\xE7\xE3o"
  description: "Carmen jurou que viu o Diabo descendo pela estrada da mina. Eu disse
    a ela que era apenas a febre de Luke esperando o Ju\xEDzo Final. Mas quando os
    sussurros come\xE7aram na janela, Carmen trancou as portas e me deixou para tr\xE1s
    com os doentes. Todos aqui descarregam seu medo no pr\xF3ximo e fogem para o
    celeiro. Se voc\xEA est\xE1 lendo isso, o peso agora \xE9 seu."
  journalEntry: 
  range: 2.8
  advancesObjective: 0
  objectiveOnInspect: 2
